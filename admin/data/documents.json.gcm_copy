06","qty":1,"unit":"SET","rate":36000,"amount":36000,"specs":["Cricket Pitch Pad: 6.5 FT (2.0 MTR) Width x 83 FT Length (standard 1-roll 2M width) with regulation bowling & batting creases","Sports Equipment: Match pitch pad, stumps bases, and boundary markers"],"gst_rate":12},{"description":"Anti-Corrosion Surface Coating & Finishing\r\nAnti-Corrosion Treatment: 2 coats epoxy zinc chromate primer + 2 coats heavy-duty weather-shield PU finish.","hsn":"3208","qty":1,"unit":"JOB","rate":33300,"amount":33300,"specs":["Weather-resistant outdoor protective coating on all structural steelwork (24 columns + 2160 RFT tie purlins)"],"gst_rate":18},{"description":"Turnkey Fabrication, Erection & Installation Labour\r\nProfessional Installation: Laser-guided leveling, certified structural welding, specialized turf seaming, and tension rigging.","hsn":"9954","qty":7200,"unit":"SQFT","rate":9.25,"amount":66600,"specs":["Certified manpower for civil, structural steel welding/erection at 25ft elevation, turf seaming, and net rigging"],"gst_rate":18},{"description":"Transportation, Freight & Material Logistics\r\nDedicated Transportation: Dedicated vehicle freight, crane unloading, and site staging.","hsn":"9965","qty":1,"unit":"LOT","rate":21600,"amount":21600,"specs":["Freight & staging of structural steel pipes (108 tie pipes + columns), turf rolls, nets, and materials"],"gst_rate":5},{"description":"Project Engineering, Quality Inspection & Handover\r\nProject Management: Dedicated project engineer supervision, quality inspection, and test handover.","hsn":"9983","qty":1,"unit":"JOB","rate":21600,"amount":21600,"specs":["Engineering supervision, alignment calibration, and final handover certificate"],"gst_rate":18}],"subtotal":2307641.22,"discount_type":"percent","discount_percent":0,"discount_flat":0,"discount_amount":0,"taxable_value":2307641.22,"is_gst":true,"gst_mode":"cgst_sgst","cgst_rate":0,"cgst_amount":143776.03,"sgst_rate":0,"sgst_amount":143776.03,"igst_rate":0,"igst