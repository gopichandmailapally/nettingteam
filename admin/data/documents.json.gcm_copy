lights_count":{"essential":6,"commercial":8,"premium_pro":12}},"excluded_items":[{"description":"Project Engineering, Quality Inspection & Handover\\nProject Management: Dedicated project engineer supervision, quality inspection, and test handover.","hsn":"9983","qty":"1","unit":"JOB","rate":"12800","gst_rate":"18","amount":"12800","specs":["Safe transport of heavy pipes, turf rolls, nets, and aggregate to project site"]}]},"scope_items":[{"title":"1. Civil Ground Base & Compaction","description":"Engineered sub-base preparation including site excavation (6-9 inches), heavy mechanical roller compaction, geotextile anti-weed membrane, 75mm-100mm graded blue metal aggregate (WMM/GSB) and 25mm stone dust leveling layer with 0.5% laser-graded slope.","note":"Provides all-weather playability and prevents surface undulations."},{"title":"2. Sub-Surface & Perimeter Drainage","description":"Engineered drainage system with perforated PVC drain pipes in aggregate trenches or French drain channels along perimeter with catch pits and stormwater gradient connection.","note":"Ensures zero water accumulation even during heavy rainfall."},{"title":"3. Structural MS/GI Cage & Column Framework","description":"Heavy-duty vertical columns (3\"x3\" or 4\"x4\" SHS MS/GI pipes) spaced at engineered 15 ft bays, anchored into 1.5ft x 1.5ft x 3ft deep M20 concrete footings. 4 tiers of horizontal tie purlins running continuously around perimeter. Anti-rust primer + double coat weather-resistant PU finish.","note":"Engineered for high wind load stability and long service life."},{"title":"4. Sports Netting System (Side & Top)","description":"UV-stabilized HDPE braided / Russea™ high-tenacity sports netting (40mm-45mm square mesh). Side/back ball-stop protection up to full court height, plus heavy-duty overhead roof net supported on cross-tension steel wire ropes with turnbuckles and stainless steel D-shackles.","note":"Prevents ball escape and protects lighting fixtures and spectators."},{"title":"5. Artificial Sports Turf System","description":"High-density monofilament sports turf (30mm/40mm/50mm/60mm) with multi-layer reinforced PP + PU backing and drainage perforations. High-purity silica sand and SBR rubber granule infill evenly distributed via mechanical brush. Turf rolls bonded with 30cm seaming tape and two-part polyurethane adhesive.","note":"Meets regulation bounce, shock absorption and player traction standards."},{"title":"6. High-Output Stadium LED Floodlighting","description":"IP66/IP67 rated commercial sports LED floodlights (150W/200W/300W) mounted on structural perimeter columns. Complete with industrial weather-proof distribution board, MCBs, digital timer control, heavy 4-core copper armored cabling, and chemical earthing pit.","note":"Designed for uniform 250-350+ lux illumination for tournament-grade night play."},{"title":"7. Player Entry Gate & Court Accessories","description":"Heavy-duty steel tubular access door (3ft/4ft x 7ft) with cylinder lock, weather-proof hinges and protective padding. Official regulation inlaid court line markings, cricket pitch pad or heavy-duty football goalposts with nets.","note":"Safe and convenient player access."},{"title":"8. Complete Turnkey Installation & Handover","description":"End-to-end execution by certified sports infrastructure team. Includes laser leveling, ultrasonic structural welding checks, turf tensioning, netting rigging, lux level verification, and official handover certification.","note":"Turnkey handover — fully ready to play."}],"created_at":"2026-09-09T17:56:50+00:00","updated_at":"2026-09-09T17:56:50+00:00"},{"id":"EST-202609-021","type":"estimation","date":"2026-09-09","customer_type":"client","sale_unit_mode":"sqft","bill_to":{"name":"Riyaz Mujawar","address":"Navi peth, Solapur - 413001","gstin":"","state":"Maharastra"},"items":[{"description":"Civil Ground Preparation & Base Slab (4\" Heavy RCC Tremix Bed)\r\n4-Inch M20/M25 Grade Heavy RCC Tremix Concrete Bed: Geotextile u