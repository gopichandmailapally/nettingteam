lt_bitumen","default_side_net":"braided_2_5mm_40mm","default_top_net":"open_top","default_gates":1,"equipment_desc":"Proposal for Supply and Installation of Outdoor Multi Sports Flooring Amenities (120ft × 60ft): Open Saucer Drain (120 Rft), Asphalt Subbase Construction (7,200 Sqft), 15ft MS Square Pipe Fabrication Fencing (5,400 Sqft), RUSSEA™ 2.5mm / 40mm Green Nylon Netting (5,824 Sqft), 8-Layer Synthetic Acrylic Sports Flooring (7,200 Sqft), Fixed Tennis Poles with Tournament Net (1 Pair), and Fixed Basketball Poles with 20mm Imported Acrylic Board & Olympian Rings (1 Pair)."},"shape":"rectangular","is_training_net":false,"is_open_front":false,"open_sides":{"front":false,"back":false,"left":false,"right":false,"top":true},"gate_count":2,"civil_bed_type":"asphalt_bitumen","civil_bed_profile":{"key":"asphalt_bitumen","name":"Dual-Layer Machine-Laid Asphalt Base (ITF Tennis & Track Standard)","short_name":"Machine-Laid Asphalt Base","has_civil":true,"gauge":"40mm Dense Bituminous Macadam (DBM) + 25mm Bituminous Concrete (BC) over 150mm WMM","rates":{"essential":65,"commercial":82,"premium_pro":105},"desc":"Machine-laid asphalt base complying with international tennis/multi-sport federation standards with zero birdbaths, high flexural resilience, and laser-grade slope."},"flooring_type":"synthetic_acrylic_8layer","flooring_profile":{"key":"synthetic_acrylic_8layer","name":"8-Layer Synthetic Acrylic ITF/FIBA Cushion Court (Dual Rubber Cushion)","short_name":"8-Layer Acrylic Cushion","has_turf":true,"has_infill":false,"pile_height":"8-Layer Cushion System","category":"acrylic","rates":{"essential":65,"commercial":85,"premium_pro":110},"infill_rates":{"essential":0,"commercial":0,"premium_pro":0},"desc":"ITF / FIBA certified 8-layer cushioned acrylic coating system with resurfacer, dual coarse & fine rubberized cushion coats, UV color coats, and anti-glare textured tournament finish."},"length_ft":120,"width_ft":60,"height_ft":15,"base_area_sft":7200,"court_sft":7200,"perimeter_rft":360,"sport_type":"outdoor_multi_sports_120x60","roof_type":"open_top","has_roof":false,"is_cricket":false,"has_pitch":true,"pitch_roll_type":"full_roll","pitch_material_sft":540,"pitch_length_ft":82,"pitch_width_ft":6.5,"pitch_area_sft":533,"outfield_area_sft":6667,"is_metal_roof":false,"metal_sheet_sft":0,"roof_purlin_rft":0,"ridge_cap_rft":0,"gutter_rft":0,"downpipe_rft":0,"has_shade_net":false,"shade_net_sft":0,"shade_net_height_ft":15,"trusses_count":0,"truss_rft":0,"cross_pipes_count":0,"cross_pipe_rft":0,"pole_style":"ladder_2line","pole_profile":{"type":"ladder_2line","pole_type":"ladder_2line","pipe_size":"50x50","pipe_gauge":"2.0mm","size_label":"50mm × 50mm Square Pipe","gauge_label":"2.0mm Wall Thickness (14 Gauge)","gauge_short":"2.0mm (14G)","full_name":"Two-Lines Ladder Type Column (50mm × 50mm Square Pipe, 2.0mm (14G))","short_name":"2-Line Ladder (50x50 @ 2.0mm)","desc":"Two-lines structural ladder column featuring dual uprights with welded ladder rungs @ 1.5ft c/c for climbing access, light fixture maintenance, and high lateral wind resistance.","uprights_per_column":2,"faces_laced":1,"has_ladder":true,"rate_adj":30,"upright_ft_rate":720},"pipe_size":"50x50","pipe_gauge":"2.0mm","length_bays":8,"width_bays":4,"length_spans":{"count":8,"bay_width":15},"width_spans":{"count":4,"bay_width":15},"total_poles":24,"corner_poles":4,"intermediate_length_poles":14,"intermediate_width_poles":6,"foundation_pits":24,"tier_count":3,"tiers":[{"tier_index":1,"height_ft":0.5,"pipe_spec":"2\"x2\" Square Pipe (14G)"},{"tier_index":2,"height_ft":7.8,"pipe_spec":"1.5\"x1.5\" Square Pipe (14G)"},{"tier_index":3,"height_ft":15,"pipe_spec":"2\"x2\" Square Pipe (14G)"}],"tier_spacing":7.5,"tier_spacing_ft":7.5,"pole_type":"ladder_2line","horizontal_pipe_rft":1080,"pipe_20ft_count":54,"rungs_per_pole":10,"total_ladder_rungs":240,"ladder_rung_pipe_rft":360,"vertical_pipe_count":48,"vertical_pipe_rft":720,"side_net_key":"braided_2_5mm_45mm","side_net_profile":{"key":"braided_2_5mm_45mm","name":"2.5mm Braided HDPE (45mm Mesh - Recommended Standard)","twine":"2.5mm UV-Stabilized High-Tenacity Braided HDPE","mesh":"45mm Square Mesh","full_desc":"2.5mm UV-stabilized high-tenacity HDPE braided netting (45mm square mesh) with heavy 8mm reinforced perimeter border ropes","rate_adj":0,"net_rate":13.5},"top_net_key":"none","top_net_profile":{"key":"open_top","name":"Open Top (No Overhead Netting)","twine":"N/A","mesh":"N/A","full_desc":"Open top arena without overhead net","is_light":false,"rate_adj":0,"net_rate":0},"top_net_spec":{"name":"Open Top (No Overhead Netting)","twine":"N/A","mesh":"N/A","desc":"Open-top arena without overhead roof netting","support":"Open Top (Side & Back Nets Only)"},"side_net_sft":3780,"back_net_sft":945,"perimeter_net_sft":5670,"top_net_sft":0,"total_net_sft":5670,"wire_rope_rft":1440,"turf_type":"synthetic_acrylic_8layer","has_turf":true,"has_infill":false,"turf_area_sft":7200,"light_masts":8,"lights_count":{"essential":6,"commercial":8,"premium_pro":12}}},"scope_items":[{"title":"Drainage — Construction of Open Saucer Drain (120 Rft)","description":"Open saucer drain of width (6 inches x 24 inches) or (9 inches x 24 inches). The height of drain will be made to match the side of the court gradient. This drain will channelize water till one corner of the court.","note":"From corner of court, onward drainage connection and storm-water discharge line to be provided by client."},{"title":"Sub base — Machine-Laid Asphalt Subbase Construction (7,200 Sqft)","description":"Asphalt Subbase Construction:\r\n• Layer of up to 4\" (100mm) Compacted WMM using Stone Size 40 MM to 60 MM and Compaction in One Layer.\r\n• Cleaning of Sub base (Wire Brushing) before starting Asphalting Layers.\r\n• Tack/Primer Coat applied before BM & AC Layers (Qty Consumption up to 3kg Per 10 Sq. Meter).\r\n• Bituminous Layer of compacted thickness up to 30 mm using mix of 20 and 10 MM Stone with 80-100/60-70 Grade Bitumen (Bituminous binder up to 3.5%).\r\n• Compacting thickness of AC up to 20 mm using 6mm Stone with 80-100/60-70 Grade Bitumen (Bituminous binder up to 3.5-4%).\r\n• Final Layer of Seal Coat using Stone Dust with Bitumen to make surface appropriate for synthetic installation.","note":"If a hot mix plant is brought to the site, approach path, location and barrication should be provided by client, keeping in mind atmospheric & environmental factors."},{"title":"Fabrication — 15 Feet Height Structural Fencing (5,400 Sqft)","description":"Fencing Height: 15 ft overall height.\r\n• Vertical Posts: 72 × 72 mm MS square pipes with 3 mm wall thickness.\r\n• Horizontal Members: 50 × 50 mm MS square pipes with 2 mm wall thickness.\r\n• Post Spacing: 10 ft centre-to-centre with Top, Centre & Bottom horizontal supports.\r\n• Installation: Vertical posts embedded 2 ft in ground or fixed on base plate with anchor fasteners.\r\n• Finish: High-durability Primer and Enamel Paint in Bus Green colour.","note":"Structural column alignment and foundation embedment executed by trained fabrication team."},{"title":"Nylon Net — RUSSEA™ High-Tenacity Green Net (5,824 Sqft)","description":"RUSSEA™ High-Tenacity Green Net 2.5mm thick - 40mm box size (Garware/Tuff equivalent & exceeding specifications). Netting to be done on all four sides, provided to minimize the ball from escaping outside of the court.","note":"Tensioned with perimeter high-tensile wire rope border, fasteners & steel clips for drum-tight aesthetic finish."},{"title":"Acrylic Sports Flooring — Synthetic Sports System (7,200 Sqft)","description":"Acrylic courts give the necessary speed, texture, and vibrant colors. Multi-layer latex-based paint system that establishes surface texture, protects underlying asphalt from weather & climatic changes, enhances play speed and provides a vibrant color scheme.\r\n• Multi-Layer System with primer, resurfacer, liquid rubber cushion layers, acrylic pre-coats, UV-top coat and line markings.\r\n• Product Specification: High density for improved strength, environment friendly formulation.","note":"Includes official regulation dual-game line markings for both Badminton (contrasting yellow lines) and Basketball (white lines & red keys) matching site specifications."},{"title":"Center Tournament Net & Posts — Fixed Heavy MS Posts with Ratchet & Tournament Net (1 Pair)","description":"• Fixed Post Made of 80mm x 80mm heavy MS pipe with heavy weighted red protective base sleeves.\r\n• Equipped with special internal ratchet system for precision tightening of rope.\r\n• The ratchet enables perfect tension control of the net.\r\n• Supplied with branded professional tournament-grade net suitable for Badminton and Tennis recreational play.","note":"Heavy counterweighted red base sleeves for rigid tensioning across court width."},{"title":"Basketball Poles — Fixed Heavy MS Poles with 10 FT Rim & 20mm Acrylic Board (1 Pair)","description":"• Pole made of heavy 6\" (150mm) MS pipe equipped with 1.2 m extension overhang.\r\n• Exactly 10 FT (3.05m) regulation rim height with Olympian breakaway ring and all-weather net.\r\n• Acrylic Board Thickness: 20 MM (Imported Quality), Size of Board: 180cm x 105cm.\r\n• Industrial spray painted finish with vibrant red protective base safety padding.","note":"Complete foundation anchoring and counterbalance heavy embedding included in turnkey scope."}],"created_at":"2026-09-21T11:15:24.609165","updated_at":"2026-09-21T19:13:49+00:00"},{"id":"EST-202609-063","type":"estimation","date":"2026-09-21","customer_type":"client","sale_unit_mode":"sqft","bill_to":{"name":"Girish Puri","address":"Wing A4, Flat No.7, Second Floor, Ideal Hills, Narmada Road, Jabalpur - 482008","gstin":"","state":"Madhya Pradesh","phone":"9329887378","whatsapp":"9329887378"},"ship_to":{"show_on_doc":0,"same_as_bill":0,"name":"","address":"","phone":"","state":""},"items":[{"description":"HDPE Braided Net","hsn":"5608","qty":2250,"unit":"SQFT","rate":7.5,"amount":16875,"sp