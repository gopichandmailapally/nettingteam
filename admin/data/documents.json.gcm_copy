0001_stamp.png?v=1779087794","logo":"uploads/COMP-0001_logo.png?v=1779041108","created_at":"2026-05-16T00:00:00","updated_at":"2026-05-18T07:03:14+00:00"},"show_bank":true,"show_russea":true,"estimation_subtype":"turnkey_court","turnkey_config":{"length":120,"width":60,"height":25,"pitch_length":83,"sport_type":"box_cricket","roof_type":"top_net","package":"commercial","target_rate":320.5,"target_total":2307600,"specs":{"length":120,"width":60,"height":25,"base_area_sft":7200,"perimeter_rft":360,"sport_type":"box_cricket","roof_type":"top_net","has_roof":true,"pole_style":"s2_heavy_4x4","length_spans":{"span":120,"bays":8,"bay_width":15,"intermediate_count":7,"positions":[15,30,45,60,75,90,105]},"width_spans":{"span":60,"bays":4,"bay_width":15,"intermediate_count":3,"positions":[15,30,45]},"corner_poles":4,"intermediate_length_poles":14,"intermediate_width_poles":6,"total_poles":24,"foundation_pits":24,"horizontal_tiers":[0.5,5.4,10.3,15.2,20.1,25],"tier_count":6,"horizontal_pipe_rft":2160,"pipe_20ft_count":108,"trusses_count":9,"truss_rft":540,"side_net_sft":6300,"back_net_sft":3150,"perimeter_net_sft":9450,"top_net_sft":7560,"total_net_sft":17010,"wire_rope_rft":3564,"turf_area_sft":7344,"light_masts":6,"lights_count":{"essential":6,"commercial":8,"premium_pro":10}}},"scope_items":[{"title":"1. Civil Ground Base & Compaction","description":"Engineered sub-base preparation including site excavation (6-9 inches), heavy mechanical roller compaction, geotextile anti-weed membrane, 75mm-100mm graded blue metal aggregate (WMM/GSB) and 25mm stone dust leveling layer with 0.5% laser-graded slope.","note":"Provides all-weather playability and prevents surface undulations."},{"title":"2. Sub-Surface & Perimeter Drainage","description":"Engineered drainage system with perforated PVC drain pipes in aggregate trenches or French drain channels along perimeter with catch pits and stormwater gradient connection.","note":"Ensures zero water accumulation even during heavy rainfall."},{"title":"3. Structural MS/GI Cage & Column Framework","description":"Heavy-duty vertical columns (3\"x3\" or 4\"x4\" SHS MS/GI pipes) spaced at engineered 15 ft bays, anchored into 1.5ft x 1.5ft x 3ft deep M20 concrete footings. 4 tiers of horizontal tie purlins running continuously around perimeter. Anti-rust primer + double coat weather-resistant PU finish.","note":"Engineered for high wind load stability and long service life."},{"title":"4. Sports Netting System (Side & Top)","description":"UV-stabilized HDPE braided / Russea™ high-tenacity sports netting (40mm-45mm square mesh). Side/back ball-stop protection up to full court height, plus heavy-duty overhead roof net supported on cross-tension steel wire ropes with turnbuckles and stainless steel D-shackles.","note":"Prevents ball escape and protects lighting fixtures and spectators."},{"title":"5. Artificial Sports Turf System","description":"High-density monofilament sports turf (30mm/40mm/50mm/60mm) with multi-layer reinforced PP + PU backing and drainage perforations. High-purity silica sand and SBR rubber granule infill evenly distributed via mechanical brush. Turf rolls bonded with 30cm seaming tape and two-part polyurethane adhesive.","note":"Meets regulation bounce, shock absorption and player traction standards."},{"title":"6. High-Output Stadium LED Floodlighting","description":"IP66/IP67 rated commercial sports LED floodlights (150W/200W/300W) mounted on structural perimeter columns. Complete with industrial weather-proof distribution board, MCBs, digital timer control, heavy 4-core copper armored cabling, and chemical earthing pit.","note":"Designed for uniform 250-350+ lux illumination for tournament-grade night play."},{"title":"7. Player Entry Gate & Court Accessories","description":"Heavy-duty steel tubular access door (3ft/4ft x 7ft) with cylinder lock, weather-proof hinges and protective padding. Official regulation inlaid court line markings, cricket pitch pad or heavy-duty football goalposts with nets.","note":"Safe and convenient player access."},{"title":"8. Complete Turnkey Installation & Handover","description":"End-to-end execution by certified sports infrastructure team. Includes laser leveling, ultrasonic structural welding checks, turf tensioning, netting rigging, lux level verification, and official handover certification.","note":"Turnkey handover — fully ready to play."}],"created_at":"2026-09-07T02:41:49+00:00","updated_at":"2026-09-07T02:46:46+00:00","tax_amount":287552.06,"total":2595193.28},{"id":"EST-202609-009","type":"estimation","date":"2026-09-06","customer_type":"client","sale_unit_mode":"sqft","bill_to":{"name":"Hyderabad Sports Arena Ltd","address":"Plot 42, Financial District, Gachibowli, Hyderabad - 500032","gstin":"36AAACH7409R1ZZ","state":"Telangana"},"items":[{"description":"Civil Ground Preparation & Sub-Base Construction\r\n4-Inch Engineered Base Preparation: Excavation, heavy-roller compaction, 75mm WMM / macadam stone base, 25mm stone dust leveling with 0.5% drainage slope.","hsn":"9954","qty":5400,"unit":"SQFT","rate":40,"amount":216000,"specs":["Court Area: 90ft x 60ft = 5,400 SFT","Foundation: 20 concrete footings (1.5' x 1.5' x 3' deep)"],"gst_rate":18},{"description":"Perimeter Drainage System\r\nEngineered Perimeter Drainage: Perforated PVC sub-surface drain pipe in aggregate trench with catch pits.","hsn":"9954","qty":300,"unit":"RFT","rate":270,"amount":81000,"specs":["Total Perimeter: 300 Running Feet"],"gst_rate":18},{"description":"Structural MS/GI Columns & Horizontal Tie Framework\r\nHeavy-Duty MS/GI Framework: 4\" x 4\" MS/GI square columns (2.5mm heavy-duty), 2\" x 2\" horizontal tie purlins, zinc chromate epoxy primer + double polyurethane (PU) finish.","hsn":"7308","qty":20,"unit":"NOS","rate":19912.5,"amount":398250,"specs":["Vertical Columns: 20 Nos (4 corner + 10 length + 6 width), Clear Height: 25 FT","Horizontal Tie Pipes: 6 tiers all around (1800 RFT, 90 pipes of 20ft length)","Bay Spacing: ~15