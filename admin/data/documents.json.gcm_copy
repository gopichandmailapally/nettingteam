32,"specs":{"civil_bed_type":"concrete_rcc_4inch","civil_bed_profile":{"key":"concrete_rcc_4inch","name":"4-Inch Heavy RCC Tremix Concrete Bed (8mm TMT Rebar Mesh)","short_name":"4\" Heavy RCC Tremix Bed","badge":"4\" RCC Tremix (8mm TMT)","rates":{"essential":75,"commercial":90,"premium_pro":105},"has_civil":true,"gauge":"8mm Fe-500D TMT Steel Rebar Mesh @ 150mm (6\") c/c","desc":"4-Inch M20/M25 Grade Heavy RCC Tremix Concrete Bed: Geotextile underlay, 75mm compacted GSB base, 100mm (4-inch) heavy reinforced concrete slab with 8mm TMT steel rebar mesh @ 150mm c/c, vacuum dewatered tremix power-float finish with expansion groove cutting.","specs":["Sub-Base: Geotextile anti-weed membrane + 75mm compacted Granular Sub-Base (GSB)","RCC Slab: 100mm (4-inch) M20/M25 Grade Heavy Reinforced Concrete Slab","Steel Reinforcement: 8mm Fe-500D TMT steel rebar tied @ 150mm (6\") c/c both ways","Tremix Flooring: Vacuum dewatered power-float smooth finish with expansion groove cutting"],"standard":"IS 456 RCC & IS 1786 High-Strength TMT Rebar Standard"},"length_ft":160,"width_ft":67,"height_ft":30,"base_area_sft":10720,"court_sft":10720,"perimeter_rft":454,"sport_type":"box_cricket","roof_type":"open_top","has_roof":false,"top_net_spec":{"name":"Open Top (No Overhead Netting)","twine":"N/A","mesh":"N/A","desc":"Open-top arena without overhead roof netting","support":"Open Top (Side & Back Nets Only)"},"pole_style":"ladder_2line","pipe_size":"40x40","pipe_gauge":"2.0mm","pole_profile":{"pole_type":"ladder_2line","pipe_size":"40x40","pipe_gauge":"2.0mm","size_label":"40mm × 40mm Square Pipe","gauge_label":"2.0mm Wall Thickness (14 Gauge)","gauge_short":"2.0mm (14G)","uprights_per_column":2,"faces_laced":1,"has_ladder":true,"full_name":"🪜 2-Lines Ladder-Type Column (Dual 40mm × 40mm Square Pipe, 2.0mm (14G), 1.5' Rungs)","short_name":"2-Line Ladder (Dual 40mm × 40mm, 2.0mm)","material_desc":"2-Lines Welded Ladder Column fabricated from Dual 40mm × 40mm Square Pipe with 1.5\" OD welded ladder rungs @ 1.5 FT c/c","standard_code":"IS 4923 / IS 1239 Grade YSt-240 Structural Hollow Sections","rate_adj":24},"turf_type":"non_infill_turf","has_turf":true,"has_infill":false,"length_spans":{"count":11,"bay_width":14.5},"width_spans":{"count":4,"bay_width":16.8},"bay_length_ft":14.5,"bay_width_ft":16.8,"corner_poles":4,"intermediate_length_poles":20,"intermediate_width_poles":6,"total_poles":30,"foundation_pits":30,"horizontal_tiers":[{"tier_index":1,"height_ft":0,"pipe_spec":"2.0\" Round Pipe (14G)"},{"tier_index":2,"height_ft":5,"pipe_spec":"1.5\" Round Pipe (14G)"},{"tier_index":3,"height_ft":10,"pipe_spec":"1.5\" Round Pipe (14G)"},{"tier_index":4,"height_ft":15,"pipe_spec":"1.5\" Round Pipe (14G)"},{"tier_index":5,"height_ft":20,"pipe_spec":"1.5\" Round Pipe (14G)"},{"tier_index":6,"height_ft":25,"pipe_spec":"1.5\" Round Pipe (14G)"},{"tier_index":7,"height_ft":30,"pipe_spec":"2.0\" Round Pipe (14G)"}],"tier_count":7,"tier_spacing_ft":5,"horizontal_pipe_rft":3178,"pipe_20ft_count":159,"vertical_pipe_count":60,"vertical_pipe_rft":1800,"ladder_rungs_per_pole":20,"total_ladder_rungs":600,"ladder_rung_pipe_rft":900,"trusses_count":0,"truss_rft":0,"cross_pipes_count":0,"cross_pipe_rft":0,"side_net_sft":10080,"back_net_sft":4221,"perimeter_net_sft":14301,"top_net_sft":0,"total_net_sft":14301,"wire_rope_rft":3632,"turf_area_sft":10720,"light_masts":8,"lights_count":{"essential":6,"commercial":8,"premium_pro":12},"side_net_key":"braided_2_5mm_45mm","top_net_key":"twisted_1_5mm_35mm","side_net_profile":{"key":"braided_2_5mm_45mm","name":"2.5mm HDPE Braided Net (45mm Square Mesh)","short_name":"2.5mm Braided (45mm Mesh)","twine":"2.5mm UV-Stabilized High-Tenacity Braided HDPE","mesh":"45mm Square Mesh","full_desc":"2.5mm UV-stabilized high-tenacity HDPE braided knotted netting (45mm square mesh, 120+ kgf breaking strength)","rate_adj":0},"top_net_profile":{"key":"twisted_1_5mm_35mm","name":"1.5mm / 24-Ply Twisted HDPE Net (35mm Square Mesh - Lightweight)","short_name":"1.5mm Twisted (35mm Mesh)","twine":"1.5mm / 24-Ply UV Stabilized HDPE Twisted Net","mesh":"35mm Square Mesh","full_desc":"1.5mm / 24-ply high-tenacity UV-stabilized HDPE twisted netting (35mm square mesh, lightweight suspension grade)","is_light":true,"rate_adj":0}},"excluded_items":[{"description":"Player Access Gate & Hardware\nHeavy-Duty Entry Gate: 4ft x 7ft heavy-duty MS/GI access door with cylinder lock, safety foam padding, and weather-proof hinges.","hsn":"7308","qty":"1","unit":"SET","rate":"75040","gst_rate":"18","amount":"75040","specs":["Access control door (4ft x 7ft) with heavy-duty hinges, lock, and mesh panel"]},{"description":"Perimeter Drainage System\nEngineered Perimeter Drainage: Perforated PVC sub-surface drain pipe in aggregate trench with catch pits.","hsn":"9954","qty":"454","unit":"RFT","rate":"354.19","gst_rate":"18","amount":"160802.26","specs":["Total Perimeter: 454 Running Feet"]}]},"scope_items":[{"title":"1. Civil Ground Base & 4\" RCC Tremix Concrete Bed","description":"Engineered sub-base preparation with 75mm compacted GSB base, geotextile anti-weed membrane, and 100mm (4-inch) heavy reinforced concrete slab (M20/M25 grade) with 8mm Fe-500D TMT rebar mesh @ 150mm (6\") c/c, laser-guided level gradient, and vacuum-dewatered tremix power-float smooth finish with expansion groove cutting.","note":"Provides heavy load-bearing structural integrity, crack prevention, and zero surface undulations."},{"title":"2. Sub-Surface & Perimeter Drainage","description":"Engineered drainage system with perforated PVC drain pipes in aggregate trenches or French drain channels along perimeter with catch pits and stormwater gradient connection.","note":"Ensures zero water accumulation even during heavy rainfall."},{"title":"3. Structural Column & Cage Framework (2-Line Ladder (Dual 40mm × 40mm, 2.0mm))","description":"Heavy-duty vertical structural columns (🪜 2-Lines Ladder-Type Column (Dual 40mm × 40mm Square Pipe, 2.0mm (14G), 1.5' Rungs)) spaced at engineered ~14.5 ft bays, anchored into 1.5ft x 1.5ft x 3ft deep M20 concrete footings. 7 tiers of horizontal tie purlins running continuously around perimeter. Anti-rust primer + double coat weather-resistant PU finish.","note":"Engineered for high wind load stability and long service life."},{"title":"4. Sports Netting System (Open Top - 2.5mm Braided (45mm Mesh))","description":"UV-stabilized High-Density Polyethylene (HDPE) sports netting system. Perimeter side & back ball-stop protection up to full 30 FT clear height (14,301 SFT) using 2.5mm UV-stabilized high-tenacity HDPE braided knotted netting (45mm square mesh, 120+ kgf breaking strength) fixed with tension wire ropes, turnbuckles, and SS shackles (Open-top arena without overhead roof netting).","note":"Prevents ball escape and protects lighting fixtures and spectators."},{"title":"5. Artificial Sports Turf System (30mm Non-Infill Multi-Sport)","description":"High-density texturized curled polyethylene monofilament (30mm pile height, 16,800 stitches/sqm) with heavy PU backing — ZERO INFILL REQUIRED. Eliminates silica sand and rubber granules while delivering consistent ball bounce, true player traction, and zero infill splash or recurring maintenance.","note":"Zero sand/rubber infill eliminates splashing and recurring maintenance."},{"title":"6. High-Output Stadium LED Floodlighting (8 × 200W LEDs)","description":"IP66/IP67 rated commercial sports LED floodlights (8 Nos × 200W) mounted on structural perimeter columns. Complete with industrial weather-proof distribution board, MCBs, digital timer control, heavy 4-core copper armored cabling, and chemical earthing pit.","note":"Designed for uniform 250-350+ lux illumination for tournament-grade night play."},{"title":"7. Player Entry Gate & Court Accessories","description":"Heavy-duty steel tubular access door (4ft x 7ft) with cylinder lock, weather-proof hinges and protective padding. Official regulation inlaid court line markings, cricket pitch pad or heavy-duty football goalposts with nets.","note":"Safe and convenient player access."},{"title":"8. Complete Turnkey Installation & Handover","description":"End-to-end execution by certified sports infrastructure team. Includes laser leveling, ultrasonic structural welding checks, turf tensioning, netting rigging, lux level verification, and official handover certification.","note":"Turnkey handover — fully ready to play."}],"created_at":"2026-09-12T07:29:10+00:00","updated_at":"2026-09-12T07:33:52+00:00"},{"id":"INV-202609-003","type":"tax_invoice","date":"2026-09-17","customer_type":"client","sale_unit_mode":"sqft","bill_to":{"name":"ULTRA DIMENSIONS PVT LTD","address":"Plot No. 2B & 3, IIM Road, Gambeeram, Visakhapatnam - 531163","gstin":"37AABCU0393A1ZO","state":"Andhra Pradesh","phone":"9502944409","whatsapp":"9502944409"},"ship_to":{"show_on_doc":1,"same_as_bill":0,"name":"ULTRA DIMENSIONS PVT LTD","address":"Plot No. 2B & 3, IIM Road, Gambeeram, Visakhapatnam - 531163","phone":"9502944409","state":"Andhra Pradesh"},"items":[{"description":"BOX CRICKET NET RUSSEA™ BRANDED","hsn":"5608","qty":8740,"unit":"SQFT","rate":9,"amount":78660,"specs":["Thickness : 2.5MM","Square Gap : 45MM","Colour : GREEN"],"gst_rate":5},{"description":"ARTIFICIAL GRASS","hsn":"5703","qty":1460,"unit":"SQFT","rate":33,"amount":48180,"specs":["Pile Height : 35MM","Layer : DOUBLE LAYER","Colour : GREEN"],"gst_rate":5},{"description":"CRICKET PITCH TURF","hsn":"5703","qty":540,"unit":"SQFT","rate":75,"amount":40500,"specs":["Pile Height : 15MM","Layer : DOUBLE","Colour : GREEN"],"gst_rate":5}],"subtotal":167340,"discount_type":"percent","discount_percent":0,"discount_flat":0,"discount_amount":0,"taxable_value":167340,"is_gst":true,"gst_mode":"igst","cgst_rate":0,"cgst_amount":0,"sgst_rate":0,"sgst_amount":0,"igst_rate":5,"igst_amount":8367,"gst_breakdown":[{"rate":5,"taxable":167340,"igst_rate":5,"igst_amount":8367,"total_tax":8367}],"grand_total":175707,"amount_in_words":"Rupees 